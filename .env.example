SUPABASE_URL=http://localhost:15435
SUPABASE_PUBLISHABLE_KEY=<redacted>
SUPABASE_SERVICE_ROLE_KEY=<redacted>
SUPABASE_PROJECT_ID=local

VITE_SUPABASE_URL=http://localhost:15435
VITE_SUPABASE_PUBLISHABLE_KEY=<redacted>
VITE_SUPABASE_PROJECT_ID=local

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:latest                    # Default local model (fast, 2.5GB, fits VRAM)
# Baseline timeout for extraction agents. Generation-heavy agents
# (writer/strategist/critic) get a hard 5-minute floor in code regardless —
# measured dolphin3 drafting on an 8GB GPU runs 50-95s warm plus cold load,
# so values under 180000 abort mid-generation. Keep >= 180000.
OLLAMA_TIMEOUT_MS=180000

# Cloud providers DISABLED (local-first architecture).
# Re-enable by uncommenting keys and removing the `DISABLE_CLOUD_LLM=1` flag.
DISABLE_CLOUD_LLM=1
# GROQ_API_KEY=<redacted>
# GOOGLE_AI_STUDIO_KEY=<redacted>
# CEREBRAS_API_KEY=<redacted>

# Optional: only raises Jina Reader's rate limit above the free anonymous
# tier (which works fine without this key — verified live 2026-07-30).
# Jina Search (s.jina.ai) is NOT used anymore: its free tier was removed and
# it now requires a paid key. Replaced by the local SearXNG instance in
# supabase/docker/docker-compose.yml (SEARXNG_BASE_URL, default
# http://localhost:15436) — no key needed.
# JINA_API_KEY=<redacted>
# FIRECRAWL_API_KEY=<redacted>
USE_FIRECRAWL=0
